# Copy this file to .env and set your mail provider's SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=your-smtp-password

FROM_EMAIL=contact@mtthw.xyz
TO_EMAIL=recipient@example.com
TO_NAME=Your Name

# Security Configuration (use "*" to allow all origins, or specify comma-separated domains)
ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# Optional Configuration
IMAGE_TAG=main
PORT=8080
# Host port for Docker Compose; the container listens on PORT.
HOST_PORT=8080
FORM_TITLE=Contact Me
STATUS_REDIRECT_URL=https://yourdomain.com/contact
RATE_LIMIT_MAX_EMAILS=3
RATE_LIMIT_WINDOW=24h
# Set only when a reverse proxy forwards requests to FormFling. List the proxy IP ranges.
# TRUSTED_PROXY_CIDRS=172.20.0.2/32

# Status page template (defaults to relative path)
STATUS_TEMPLATE=./web/templates/status_template.html

# Timezone Configuration
TZ=UTC
